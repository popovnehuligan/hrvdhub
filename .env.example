# Copy this file to .env and fill it in. Never commit .env: it holds the bot token.

# Token from @BotFather.
BOT_TOKEN=

# Public https address of the app. Telegram only opens Mini Apps over https.
PUBLIC_URL=https://wishlist.horovod.sk
# The same domain without https://. Only used by docker-compose so Caddy can get the certificate.
DOMAIN=wishlist.horovod.sk

# The HOROVOD Telegram group. Send /chatid in the group to get it (looks like -1001234567890).
# Members of this group can use the wishlist; its admins can plan, mark bought, drop and delete.
GROUP_CHAT_ID=

# Optional: extra people by Telegram user id, comma separated (send /chatid to the bot privately to see yours).
ADMIN_IDS=
ALLOWED_USER_IDS=

# Optional: post news and reminders to a different chat than GROUP_CHAT_ID.
NOTIFY_CHAT_ID=

# Optional: the link used on buttons in group messages. Defaults to https://t.me/<your bot>?startapp,
# which works once the Mini App is enabled in BotFather. Set it if you used /newapp instead,
# e.g. https://t.me/horovod_bot/wishlist
APP_LINK=

CURRENCY=EUR
TIMEZONE=Europe/Bratislava
# Hour (in TIMEZONE) when the daily "coming up to buy" reminder goes out.
REMINDER_HOUR=10

PORT=3000
